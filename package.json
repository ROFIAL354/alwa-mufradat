{
  "name": "alwa-mufradat-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for ALWA Mufradat Vocab & Sentence Generator",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
